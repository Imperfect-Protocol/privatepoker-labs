{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "outDir": "build",
    "rootDir": ".",
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "declaration": true,
    "sourceMap": false,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "types-node.d.ts"
  ],
  "exclude": [
    "src/app/main.ts"
  ]
}
